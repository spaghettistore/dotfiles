# /etc/inputrc - global inputrc for libreadline
# See readline(3readline) and `info rluserman' for more information.

# Be 8 bit clean.
set input-meta on
set output-meta on

# To allow the use of 8bit-characters like the german umlauts, uncomment
# the line below. However this makes the meta key not work as a meta key,
# which is annoying to those which don't need to type in 8-bit characters.

# set convert-meta off

# try to enable the application keypad when it is called.  Some systems
# need this to enable the arrow keys.
# set enable-keypad on

# see /usr/share/doc/bash/inputrc.arrows for other codes of arrow keys

# do not bell on tab-completion
# set bell-style none
# set bell-style visible

# make autocompletion case insensitive and display suggestions
set completion-ignore-case On
set show-all-if-ambiguous On

# some defaults / modifications for the emacs mode
$if mode=emacs

# allow the use of the Home/End keys
"\e[1~": beginning-of-line
"\e[4~": end-of-line

# allow the use of the Delete/Insert keys
"\e[3~": delete-char
"\e[2~": quoted-insert

# mappings for "page up" and "page down" to step to the beginning/end
# of the history
# "\e[5~": beginning-of-history
# "\e[6~": end-of-history

# alternate mappings for "page up" and "page down" to search the history
# "\e[5~": history-search-backward
# "\e[6~": history-search-forward

# mappings for Ctrl-left-arrow and Ctrl-right-arrow for word moving
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[5C": forward-word
"\e[5D": backward-word
"\e\e[C": forward-word
"\e\e[D": backward-word

$if term=rxvt
"\e[7~": beginning-of-line
"\e[8~": end-of-line
"\eOc": forward-word
"\eOd": backward-word
$endif

# for non RH/Debian xterm, can't hurt for RH/Debian xterm
# "\eOH": beginning-of-line
# "\eOF": end-of-line

# for freebsd console
# "\e[H": beginning-of-line
# "\e[F": end-of-line

$endif

# ------------
# Vim Keybinds
# ------------

# Use this instead of 'set -o vi' in '~/.bashrc', so that all readline() based apps use vi keybinds
set editing-mode vi
set keymap vi

# Show vim mode in terminal prompt
set show-mode-in-prompt on
# Change default mode indicator prompt prefix
#set vi-ins-mode-string "+"  # Change from default '(ins)' prompt prefix
#set vi-cmd-mode-string ":"  # Change from default '(cmd)' prompt prefix
# Change cursor from block to line when in insert (like nvim)
set vi-cmd-mode-string "\1\e[2 q\2"
set vi-ins-mode-string "\1\e[6 q\2"
# Change cursor depending on mode, and add mode indicator to prompt prefix
#set vi-cmd-mode-string "\1\e[2 q\2(cmd)"
#set vi-ins-mode-string "\1\e[6 q\2(ins)"

$if mode=vi
    # This sets keybinds for normal(cmd) mode
    set keymap vi-command

    control-l: clear-screen

    # {operator} {inside/around} {word/WORD}
    "diw": "lbdw"
    "ciw": "lbcw"
    "yiw": "lbyw"
    "daw": "lbdw"
    "caw": "lbcw"
    "yaw": "lbyw"
    "diW": "lBdW"
    "ciW": "lBcW"
    "yiW": "lByW"
    "daW": "lBdW"
    "caW": "lBcW"
    "yaW": "lByW"
    # {operator} {inside/around} double quotes
    "di\"": "lT\"dt\""
    "ci\"": "lT\"ct\""
    "yi\"": "lT\"yt\""
    "da\"": "lF\"df\""
    "ca\"": "lF\"cf\""
    "ya\"": "lF\"yf\""
    # {operator} {inside/around} single quotes
    "di\'": "lT\'dt\'"
    "ci\'": "lT\'ct\'"
    "yi\'": "lT\'yt\'"
    "da\'": "lF\'df\'"
    "ca\'": "lF\'cf\'"
    "ya\'": "lF\'yf\'"
    # {operator} {inside/around} backticks
    "di`": "lT`dt`"
    "ci`": "lT`ct`"
    "yi`": "lT`yt`"
    "da`": "lF`df`"
    "ca`": "lF`cf`"
    "ya`": "lF`yf`"
    # {operator} {inside/around} parenthesis
    "di(": "lT(dt)"
    "di)": "lT(dt)"
    "dib": "lT(dt)"
    "ci(": "lT(ct)"
    "ci)": "lT(ct)"
    "cib": "lT(ct)"
    "yi(": "lT(yt)"
    "yi)": "lT(yt)"
    "yib": "lT(yt)"
    "da(": "lF(df)"
    "da)": "lF(df)"
    "dab": "lF(df)"
    "ca(": "lF(cf)"
    "ca)": "lF(cf)"
    "cab": "lF(cf)"
    "ya(": "lF(yf)"
    "ya)": "lF(yf)"
    "yab": "lF(yf)"
    # {operator} {inside/around} square brackets
    "di[": "lT[dt]"
    "di]": "lT[dt]"
    "ci[": "lT[ct]"
    "ci]": "lT[ct]"
    "yi[": "lT[yt]"
    "yi]": "lT[yt]"
    "da[": "lF[df]"
    "da]": "lF[df]"
    "ca[": "lF[cf]"
    "ca]": "lF[cf]"
    "ya[": "lF[yf]"
    "ya]": "lF[yf]"
    # {operator} {inside/around} braces/curly brackets
    "di{": "lT{dt}"
    "di}": "lT{dt}"
    "diB": "lT{dt}"
    "ci{": "lT{ct}"
    "ci}": "lT{ct}"
    "ciB": "lT{ct}"
    "yi{": "lT{yt}"
    "yi}": "lT{yt}"
    "yiB": "lT{yt}"
    "da{": "lF{df}"
    "da}": "lF{df}"
    "daB": "lF{df}"
    "ca{": "lF{cf}"
    "ca}": "lF{cf}"
    "caB": "lF{cf}"
    "ya{": "lF{yf}"
    "ya}": "lF{yf}"
    "yaB": "lF{yf}"
    # {operator} {inside/around} angle brackets
    "di<": "lT<dt>"
    "di>": "lT<dt>"
    "ci<": "lT<ct>"
    "ci>": "lT<ct>"
    "yi<": "lT<yt>"
    "yi>": "lT<yt>"
    "da<": "lF<df>"
    "da>": "lF<df>"
    "ca<": "lF<cf>"
    "ca>": "lF<cf>"
    "ya<": "lF<yf>"
    "ya>": "lF<yf>"
    # {operator} {inside/around} forward slashes
    "di/": "lT/dt/"
    "ci/": "lT/ct/"
    "yi/": "lT/yt/"
    "da/": "lF/df/"
    "ca/": "lF/cf/"
    "ya/": "lF/yf/"
    # Surround {word/WORD} with things (depends on custom made 'ciw' and 'ciW')
    "gsw\"": "ciw\"\"P"
    "gsW\"": "ciW\"\"P"
    "gsw\'": "ciw\'\'P"
    "gsW\'": "ciW\'\'P"
    "gsw`": "ciw``P"
    "gsW`": "ciW``P"
    "gsw(": "ciw()P"
    "gsw)": "ciw()P"
    "gswb": "ciw()P"
    "gsW(": "ciW()P"
    "gsW)": "ciW()P"
    "gsWb": "ciW()P"
    "gsw[": "ciw[]P"
    "gsw]": "ciw[]P"
    "gsW[": "ciW[]P"
    "gsW]": "ciW[]P"
    "gsw{": "ciw{}P"
    "gsw}": "ciw{}P"
    "gswB": "ciw{}P"
    "gsW{": "ciW{}P"
    "gsW}": "ciW{}P"
    "gsWB": "ciW{}P"
    "gsw<": "ciw<>P"
    "gsw>": "ciw<>P"
    "gsW<": "ciW<>P"
    "gsW>": "ciW<>P"

    # This sets keybinds for normal(ins) mode
    set keymap vi-insert

    # Like emacs
    control-l: clear-screen
    control-p: history-search-backward
    control-n: history-search-forward
    control-a: beginning-of-line
    control-e: end-of-line
    control-k: kill-line

    # Arrow keys up/down use what is in prompt to search history 
    "\e[A": history-search-backward
    "\e[B": history-search-forward
$endif
