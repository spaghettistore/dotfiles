# Default config file: /etc/sway/config

include /etc/sway/config-vars.d/*

# Table of Contents:
#   01. VARIABLES
#   02. STATUS BAR
#   03. NOTIFICATIONS
#   04. IDLE CONFIGURATION
#   05. OUTPUT CONFIGURATION
#   06. INPUT
#   07. KEY BINDINGS
#   08. CUSTOM MODES
#   09. FLOATING DEFAULTS
#   10. VANITY
#   11. XWAYLAND

# -------------
# 01. VARIABLES
# -------------

# Mod4=WindowsKey, Mod1=Alt, Mod5=AltGr, menu=KeyboardMenuKey
set $super Mod4

# Application Prefrences
set $term alacritty
set $browser firefox
set $file_manager ranger
set $menu pkill rofi || rofi -i -show drun -show-icons
set $menu2 pkill rofi || rofi -i -show run

# --------------
# 02. STATUS BAR
# --------------

# Read 'man 5 sway-bar' for more information about this section.

bar {
    swaybar_command waybar
}
include /etc/sway/config.d/*

# -----------------
# 03. NOTIFICATIONS
# -----------------

exec swaync
bindsym $super+i exec swaync-client -t -sw
exec ~/.config/sway/bat_notify.sh

bindsym $super+t exec notify-send --transient "$(date "+%a %d %b %H:%M")" --urgency=low --app-name="datetime_notification" --hint=string:x-canonical-private-synchronous:"datetime_notification"
bindsym $super+alt+i exec ~/.config/sway/info_notification.sh "time" "wifi" "battery"

# ----------------------
# 04. IDLE CONFIGURATION
# ----------------------

# Read 'man swayidle' EXAMPLE section for more information.

# Turn off screen, then lock, then sleep.
exec swayidle -w \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 660 'swaylock -f' \
    timeout 1200 'systemctl suspend'

# Disable swayidle whan an application is fullscreen
for_window [class="."] inhibit_idle fullscreen
for_window [app_id="."] inhibit_idle fullscreen

# ------------------------
# 05. OUTPUT CONFIGURATION
# ------------------------

# You can get the names of your outputs by running: 'swaymsg -t get_outputs'

### Default wallpaper
output * {
    bg ~/.config/sway/background.jpg fill
}

### Monitor Configuration

# This layout is for no external monitor connected
output eDP-1 {
    resolution 1920x1080
    position 0,0
}

# This layout is to make Steam games work normally with an external monitor connected
#output eDP-1 {
#    resolution 1920x1080
#    position 1920,0
#}
#output HDMI-A-1 {
#    resolution 1920x1080
#    position 0,0
#}

### Bind workspace to specific monitor
#workspace 1 output eDP-1
#workspace 2 output HDMI-A-1

# ---------
# 06. INPUT
# ---------

# You can get the names of your inputs by running: 'swaymsg -t get_inputs'
# Read `man 5 sway-input` for more information about this section.


### Keyboard
input type:keyboard {
    xkb_layout "gb"
    xkb_variant ""
    xkb_options "caps:escape"
    xkb_numlock disabled
    xkb_capslock disabled
}
# Colemak
    #xkb_layout "gb,gb"
    #xkb_variant ",colemak"
    #xkb_options "caps:escape,grp:alt_shift_toggle"
# Alternative Keyboard Layouts
    # Capslock Escape, Layout Switcher
        #xkb_options "caps:escape_shifted_capslock"
        #xkb_options "caps:escape,grp:alt_shift_toggle"
        #xkb_options "caps:escape,grp:shift_caps_toggle"
    # Dvorak | Dvorak programmer | UK Punctuation
        #xkb_layout "gb,us"
        #xkb_variant "<dvorak|dvorakukp>,<dvorak|dvp|dvorak-classic>"
    # Colemak
        #xkb_layout "<gb|us>"
        #xkb_variant "<colemak|colemak_dh>"

### Mouse
# Touchpad
input type:touchpad {
    tap enabled
    dwt enabled
    middle_emulation enabled
    pointer_accel 0.10
    #natural_scroll enabled
    #accel_profile "flat"
}

# Mouse
input type:pointer {
    # Disable mouse acceleration
    accel_profile "flat"
    # Mouse speed
    pointer_accel -0.25
}

focus_follows_mouse yes

# ----------------
# 07. KEY BINDINGS
# ----------------

bindsym $super+apostrophe exec pkill rofi || ~/.config/sway/sway_rofi_focus_window.py

### System
# Basic
bindsym $super+c kill
bindsym $super+Shift+c reload
bindsym $super+Shift+e exec swaynag -t warning -m 'Log out?' -B 'Yes, exit sway' 'swaymsg exit'
# Launcher
bindsym $super+d exec $menu
bindsym $super+Shift+d exec $menu2
# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +2% && ~/.config/sway/current_volume_notification.sh
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -2% && ~/.config/sway/current_volume_notification.sh
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && ~/.config/sway/current_volume_notification.sh
# Brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && ~/.config/sway/current_brightness_notification.sh
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+ && ~/.config/sway/current_brightness_notification.sh
# Media
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
# Toggle enable/disable touchpad
bindsym XF86TouchpadToggle input type:touchpad events toggle enabled disabled, exec ~/.config/sway/info_notification.sh "touchpad"
# Swaylock
bindsym $super+Shift+x exec systemctl suspend && swaylock
# Applications
bindsym $super+Return exec $term
bindsym $super+b exec $browser
bindsym $super+e exec "$term -e $file_manager"
bindsym $super+Equal exec "$term -e bc -l"
bindsym XF86Calculator exec "$term -e bc -l"
# Screenshot / printscreen
bindsym Print exec grim /tmp/grim_temp_screenshot.png && wl-copy < /tmp/grim_temp_screenshot.png && rm /tmp/grim_temp_screenshot.png && notify-send "Screenshot saved to clipboard" --urgency=low --app-name="screenshot_to_clipboard_notification" --hint=string:x-canonical-private-synchronous:"screenshot_to_clipboard_notification"
bindsym $super+Print exec grim && notify-send "Screenshot saved to file" --urgency=low --app-name="screenshot_saved_notification" --hint=string:x-canonical-private-synchronous:"screenshot_saved_notification"

### Focus
# Vim
bindsym $super+h focus left
bindsym $super+j focus down
bindsym $super+k focus up
bindsym $super+l focus right
# Arrow Keys
bindsym $super+Left focus left
bindsym $super+Down focus down
bindsym $super+Up focus up
bindsym $super+Right focus right
# Switch to workspace
bindsym $super+1 workspace number 1
bindsym $super+2 workspace number 2
bindsym $super+3 workspace number 3
bindsym $super+4 workspace number 4
bindsym $super+5 workspace number 5
bindsym $super+6 workspace number 6
bindsym $super+7 workspace number 7
bindsym $super+8 workspace number 8
bindsym $super+9 workspace number 9
bindsym $super+0 workspace number 10
bindsym $super+p workspace prev
bindsym $super+n workspace next
bindsym ctrl+alt+Left workspace prev
bindsym ctrl+alt+Right workspace next
bindsym $super+page_up workspace prev
bindsym $super+page_down workspace next
bindsym $super+Shift+tab workspace prev
bindsym $super+tab workspace next
# Parent Child
bindsym $super+a focus parent
bindsym $super+q focus child
# Monitor
bindsym $super+bracketright focus output right
bindsym $super+bracketleft focus output left
bindsym $super+alt+l focus output right
bindsym $super+alt+h focus output left
bindsym $super+alt+k focus output up
bindsym $super+alt+j focus output down
bindsym $super+alt+Right focus output right
bindsym $super+alt+Left focus output left
bindsym $super+alt+Up focus output up
bindsym $super+alt+Down focus output down
bindsym $super+alt+n focus output next
bindsym $super+alt+p focus output prev

### Move [Focused Container]
# Vim
bindsym $super+Shift+h move left
bindsym $super+Shift+j move down
bindsym $super+Shift+k move up
bindsym $super+Shift+l move right
# Arrow Keys
bindsym $super+Shift+Left move left
bindsym $super+Shift+Down move down
bindsym $super+Shift+Up move up
bindsym $super+Shift+Right move right
# Workspace
bindsym $super+Shift+1 move container to workspace number 1
bindsym $super+Shift+2 move container to workspace number 2
bindsym $super+Shift+3 move container to workspace number 3
bindsym $super+Shift+4 move container to workspace number 4
bindsym $super+Shift+5 move container to workspace number 5
bindsym $super+Shift+6 move container to workspace number 6
bindsym $super+Shift+7 move container to workspace number 7
bindsym $super+Shift+8 move container to workspace number 8
bindsym $super+Shift+9 move container to workspace number 9
bindsym $super+Shift+0 move container to workspace number 10
bindsym $super+Shift+p move container to workspace prev
bindsym $super+Shift+n move container to workspace next
bindsym Shift+ctrl+alt+Left move container to workspace prev
bindsym Shift+ctrl+alt+Right move container to workspace next
bindsym $super+Shift+page_up move container to workspace prev
bindsym $super+Shift+page_down move container to workspace next
### Move [Workspace] between monitors
bindsym $super+Shift+bracketright move workspace to output right
bindsym $super+Shift+bracketleft move workspace to output left
bindsym $super+Shift+alt+l move workspace to output right
bindsym $super+Shift+alt+h move workspace to output left
bindsym $super+Shift+alt+k move workspace to output up
bindsym $super+Shift+alt+j move workspace to output down
bindsym $super+Shift+alt+Right move workspace to output right
bindsym $super+Shift+alt+Left move workspace to output left
bindsym $super+Shift+alt+Up move workspace to output up
bindsym $super+Shift+alt+Down move workspace to output down
bindsym $super+Shift+alt+n move workspace to output next
bindsym $super+Shift+alt+p move workspace to output prev

### Layout
bindsym $super+f fullscreen
bindsym $super+Shift+s layout stacking
bindsym $super+Shift+t layout tabbed
bindsym $super+z layout toggle split
bindsym $super+Shift+Equal sticky toggle
#bindsym $super+Shift+z layout default

### Split
bindsym $super+v splith
bindsym $super+x splitv
#bindsym t split toggle
#bindsym n split none

### Floating
floating_modifier $super normal
bindsym $super+Space focus mode_toggle
bindsym $super+Shift+Space floating toggle

### Scratchpad
bindsym $super+minus scratchpad show
bindsym $super+shift+minus move scratchpad

# Touchpad Bindings
bindgesture swipe:3:right workspace next
bindgesture swipe:3:left workspace prev

### Marks TODO
#bindsym $super+Shift+q [con_mark="test_mark"] focus; mode "default"
#bindsym $super+Shift+z mark --add test_mark
#bindsym $super+Shift+q unmark
#bindsym $super+Shift+q move mark test_mark
#bindsym $super+Shift+a swap container with mark test_mark
show_marks yes

#workspace_auto_back_and_forth yes

bindsym $super+Slash exec pkill rofi || ~/.config/sway/sway_dmenu.sh
bindsym $super+alt+b exec pkill rofi || ~/.local/bin/bmks "rofi"
bindsym $super+Shift+alt+b exec pkill rofi || ~/.local/bin/bmks -a "rofi"

# System Controls
bindsym $super+ctrl+a exec pavucontrol
bindsym $super+ctrl+w exec pkill rofi || ~/.config/sway/wifi_menu_dmenu.py -m rofi
bindsym $super+ctrl+t exec alacritty -e btop
bindsym $super+Escape exec pkill rofi || ~/.config/sway/power_menu_dmenu.sh -m rofi
bindsym $super+ctrl+l exec systemctl suspend && swaylock
